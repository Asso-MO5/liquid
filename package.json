{
  "name": "Liquid",
  "private": true,
  "scripts": {
    "dev": "bun --bun ./node_modules/vite/bin/vite.js dev",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "start": "bun .output/server/index.mjs",
    "lint": "bun --bun ./node_modules/eslint/bin/eslint.js \"src/**/*.{ts,tsx}\"",
    "lint:fix": "bun run lint --fix",
    "check:types": "bun --bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test src",
    "test:browser": "bun --bun ./node_modules/@playwright/test/cli.js test"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "bun-types": "^1.3.10",
    "eslint": "^8.56.0",
    "eslint-plugin-solid": "^0.14.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0",
    "nitro": "^3.0.260610-beta",
    "solid-js": "^1.9.14",
    "vite": "^8.0.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
